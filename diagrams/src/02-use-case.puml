@startuml use_case_diagram
!theme plain
left to right direction
skinparam defaultFontName Arial
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #2C3E50

actor "Врач" as Doctor #E8F4F8
actor "Пациент" as Patient #E8F8F5
actor "Фармацевт" as Pharmacist #FEF9E7
actor "Администратор Минздрава" as Admin #FADBD8

rectangle "Централизованная платформа электронных рецептов (CEPP)" {
  package "Выписка и управление рецептами" {
    usecase "UC-1: Поиск пациента по ИИН" as UC1
    usecase "UC-2: Формирование рецепта по МНН" as UC2
    usecase "UC-3: Проверка лекарственной\nсовместимости и аллергий" as UC3
    usecase "UC-4: Подписание рецепта ЭЦП НУЦ РК" as UC4
    usecase "UC-5: Аннулирование / отзыв рецепта" as UC5
    usecase "UC-6: Просмотр истории назначений" as UC6
  }

  package "Кабинет пациента" {
    usecase "UC-7: Просмотр активных и архивных рецептов" as UC7
    usecase "UC-8: Получение динамического QR-токена\nна позицию рецепта" as UC8
    usecase "UC-9: Просмотр истории выдачи и инструкций" as UC9
  }

  package "Отпуск в аптеке" {
    usecase "UC-10: Сканирование и валидация QR-токена" as UC10
    usecase "UC-11: Проверка подлинности ЭЦП врача\nи статуса рецепта" as UC11
    usecase "UC-12: Подбор торгового наименования\nиз наличия" as UC12
    usecase "UC-13: Фиксация частичного или\nполного отпуска" as UC13
    usecase "UC-14: Заверение отпуска ЭЦП фармацевта" as UC14
  }

  package "Модерация и надзор" {
    usecase "UC-15: Верификация клиник и аптек по БИН" as UC15
    usecase "UC-16: Просмотр неизменяемого журнала аудита\n(Hash Chaining)" as UC16
    usecase "UC-17: Аналитика расхода антибиотиков" as UC17
  }
}

Doctor --> UC1
Doctor --> UC2
Doctor --> UC5
Doctor --> UC6
UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>

Patient --> UC7
Patient --> UC8
Patient --> UC9

Pharmacist --> UC10
Pharmacist --> UC12
Pharmacist --> UC13
UC10 ..> UC11 : <<include>>
UC13 ..> UC14 : <<include>>

Admin --> UC15
Admin --> UC16
Admin --> UC17
@enduml
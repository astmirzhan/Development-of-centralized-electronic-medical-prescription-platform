# Copy to .env and fill in local values. Never commit .env.

# API
APP_ENV=development
API_PORT=8080
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=erx
POSTGRES_USER=erx_app
POSTGRES_PASSWORD=change-me

# Auth
JWT_SIGNING_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# QR tokens
QR_TOKEN_ROTATION=60s
QR_TOKEN_ACCEPT_WINDOW=90s

# EDS verification (NCANode)
NCANODE_URL=http://ncanode:14579
NCA_TEST_MODE=true

# SMS (simulated in MVP)
SMS_PROVIDER=console
SMS_API_KEY=placeholder